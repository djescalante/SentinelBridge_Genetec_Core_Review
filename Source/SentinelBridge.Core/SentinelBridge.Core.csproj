<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TreatWarningAsError>false</TreatWarningAsError>
  </PropertyGroup>

  <!-- Solution builds compile an SDK-enabled product and an SDK-disabled unit-test
       variant in parallel. Keep their artifacts separate to prevent CS2012 locks. -->
  <PropertyGroup Condition="'$(EnableGenetecSdk)' == 'false'">
    <IntermediateOutputPath>obj\$(Configuration)\sdk-disabled\$(TargetFramework)\</IntermediateOutputPath>
    <OutputPath>bin\$(Configuration)\sdk-disabled\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
    <!-- CHANGE #001: Add Polly for resilience patterns (retry, circuit breaker) -->
    <PackageReference Include="Polly" Version="8.2.0" />
    <PackageReference Include="Polly.Extensions.Http" Version="3.0.0" />
  </ItemGroup>

  <!-- Shared Genetec Platform SDK detection (5.13 / 5.12 / none) -->
  <Import Project="..\build\GenetecSdk.props" />

</Project>

